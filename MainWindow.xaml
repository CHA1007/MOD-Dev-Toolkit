<ui:FluentWindow x:Class="MODDevToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:MODDevToolkit.Pages"
        mc:Ignorable="d"
        Title="MOD开发工具箱"
        Height="800" Width="1200"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/assets/icons/app_icon.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <!-- 标题栏仅保留窗口控制按钮，标题在侧边栏 -->
        <ui:TitleBar x:Name="RootTitleBar"
                     VerticalAlignment="Top"/>

        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="208"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           Transition="FadeInWithSlide">

            <ui:NavigationView.PaneHeader>
                <!-- 顶部留白避开标题栏 -->
                <StackPanel Margin="18,42,18,20">
                    <TextBlock Text="📦 MOD开发工具箱"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="v2.0.0"
                               FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="首页"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:HomePage}"/>
                <ui:NavigationViewItem Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}"/>
            </ui:NavigationView.MenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
