<Page x:Class="MODDevToolkit.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="首页">

    <!-- 搜索区固定、结果列表填满剩余高度并内部滚动，避免嵌套滚动面 -->
    <Grid Margin="32,48,32,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 搜索区 ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="搜索 Mod" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="从 Modrinth / CurseForge 查询 MOD，查看版本信息并生成依赖配置"
                           Style="{StaticResource HintText}" Margin="0,4,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SearchBox"
                                Grid.Column="0"
                                PlaceholderText="输入 MOD 名称，按 Enter 搜索…"
                                FontSize="14"
                                KeyDown="SearchBox_KeyDown"/>
                    <ui:Button Grid.Column="1"
                               Content="搜索"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Search24}"
                               Click="SearchButton_Click"
                               Margin="10,0,0,0"/>
                    <ui:Button Grid.Column="2"
                               Content="重置"
                               Appearance="Transparent"
                               Click="ResetButton_Click"
                               Margin="8,0,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="来源" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="SourceCombo" Width="130" SelectedIndex="0">
                        <ComboBoxItem Content="Modrinth"/>
                        <ComboBoxItem Content="CurseForge"/>
                    </ComboBox>

                    <TextBlock Text="加载器" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="24,0,10,0"/>
                    <ComboBox x:Name="LoaderCombo" Width="130" SelectedIndex="0">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="forge"/>
                        <ComboBoxItem Content="fabric"/>
                        <ComboBoxItem Content="neoforge"/>
                        <ComboBoxItem Content="quilt"/>
                    </ComboBox>

                    <TextBlock Text="游戏版本" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="24,0,10,0"/>
                    <ComboBox x:Name="GameVersionCombo" Width="200" IsEditable="True" SelectedIndex="0">
                        <ComboBoxItem Content="全部（也可自行输入）"/>
                        <ComboBoxItem Content="1.21.5"/>
                        <ComboBoxItem Content="1.21.1"/>
                        <ComboBoxItem Content="1.20.6"/>
                        <ComboBoxItem Content="1.20.1"/>
                        <ComboBoxItem Content="1.19.2"/>
                        <ComboBoxItem Content="1.18.2"/>
                        <ComboBoxItem Content="1.16.5"/>
                        <ComboBoxItem Content="1.12.2"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ 搜索结果 ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="ResultCountText"
                           Text="搜索结果"
                           Style="{StaticResource CardTitle}"
                           Margin="22,18,22,6"/>

                <ProgressBar Grid.Row="1" x:Name="LoadingBar"
                                IsIndeterminate="True"
                                Visibility="Collapsed"
                                Margin="22,0,22,8"/>

                <StackPanel Grid.Row="2" x:Name="EmptyHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,40">
                    <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="输入关键词开始搜索"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="2" x:Name="ModList"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="Collapsed"
                         ItemContainerStyle="{StaticResource ResultListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="{StaticResource SecondaryBackgroundBrush}"
                                        CornerRadius="8" VerticalAlignment="Top">
                                    <Image Source="{Binding IconUrl}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Tags}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding TagsVisibility}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>

                                    <!-- 元信息：加载器 · 版本数 · 下载量 · 更新时间 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CompatInfo}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Visibility="{Binding CompatVisibility}"/>
                                        <TextBlock Text="  ·  " FontSize="11"
                                                   Foreground="{StaticResource BorderBrush}"
                                                   Visibility="{Binding CompatVisibility}"/>
                                        <TextBlock Text="{Binding VersionCountText}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Visibility="{Binding VersionCountVisibility}"/>
                                        <TextBlock Text="  ·  " FontSize="11"
                                                   Foreground="{StaticResource BorderBrush}"
                                                   Visibility="{Binding VersionCountVisibility}"/>
                                        <TextBlock Text="↓ " FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding DownloadsText}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock Text="  ·  " FontSize="11"
                                                   Foreground="{StaticResource BorderBrush}"/>
                                        <TextBlock Text="{Binding UpdateTime}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,4,0">
                                    <TextBlock Text="{Binding SourceName}" FontSize="10" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                                    <ui:Button Content="生成配置"
                                               Appearance="Primary"
                                               FontSize="12"
                                               Click="GenerateConfig_Click"
                                               Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>
