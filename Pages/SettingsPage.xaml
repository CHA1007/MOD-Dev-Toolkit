<Page x:Class="MODDevToolkit.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="设置">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,48,32,40" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="个性化、网络与数据" Style="{StaticResource HintText}" Margin="0,4,0,26"/>

            <TextBlock Text="个性化" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <ui:CardControl Icon="{ui:SymbolIcon Color24}" Header="主题颜色"
                                Margin="4" Padding="16,12"
                                VerticalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="更改应用的强调色，立即生效并记住选择"
                                   Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal">
                        <Button Style="{StaticResource SwatchButton}" Tag="#4CA6E8" Background="#4CA6E8" Click="Swatch_Click" ToolTip="天蓝"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#5C6BC0" Background="#5C6BC0" Click="Swatch_Click" ToolTip="靛蓝"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#00A3A3" Background="#00A3A3" Click="Swatch_Click" ToolTip="青碧"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#6B8E23" Background="#6B8E23" Click="Swatch_Click" ToolTip="绿"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#8E5CD9" Background="#8E5CD9" Click="Swatch_Click" ToolTip="紫罗兰"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#E85D9B" Background="#E85D9B" Click="Swatch_Click" ToolTip="樱粉"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#E8804C" Background="#E8804C" Click="Swatch_Click" ToolTip="暮橙"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#E05252" Background="#E05252" Click="Swatch_Click" ToolTip="朱红"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
            </Border>

            <TextBlock Text="网络" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel Margin="4">
                    <ui:CardExpander Icon="{ui:SymbolIcon Globe24}" Header="Modrinth API 端点"
                                     Padding="16,12" IsExpanded="False">
                        <StackPanel Margin="8,0,0,4">
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                       Text="所有 Modrinth 搜索与版本查询都通过此地址发出（需兼容 Modrinth v2 接口）。"/>
                            <TextBlock x:Name="EndpointCurrent" Margin="0,0,0,12" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ui:TextBox x:Name="ApiEndpointBox" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="测试连接并保存"
                                           Appearance="Info"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           Click="TestEndpoint_Click"
                                           Margin="0,0,10,0"/>
                                <ui:Button Content="恢复默认"
                                           Appearance="Transparent"
                                           Click="ResetEndpoint_Click"/>
                            </StackPanel>
                            <ui:InfoBar x:Name="ApiInfoBar" Margin="0,12,0,0" IsOpen="False"/>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Icon="{ui:SymbolIcon Key24}" Header="CurseForge API Key"
                                     Margin="0,4,0,0" Padding="16,12" IsExpanded="False">
                        <StackPanel Margin="8,0,0,4">
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                       Text="CurseForge 搜索需要 API Key（点「获取 Key」前往申请页），仅保存在本地 settings.json。"/>
                            <ui:PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12"
                                            RevealButtonEnabled="True"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="验证并保存"
                                           Appearance="Info"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           Click="TestKey_Click"
                                           Margin="0,0,10,0"/>
                                <ui:Button Content="清空"
                                           Appearance="Transparent"
                                           Click="ClearKey_Click"/>
                                <ui:Button Content="获取 Key"
                                           Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Link24}"
                                           Click="OpenKeyPage_Click"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                            <ui:InfoBar x:Name="KeyInfoBar" Margin="0,12,0,0" IsOpen="False"/>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </Border>

            <TextBlock Text="数据" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <ui:CardControl Icon="{ui:SymbolIcon Database24}" Header="API 缓存"
                                Margin="4" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CacheSizeText" Text="正在统计…" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ui:InfoBar x:Name="CacheInfoBar" Width="240" Margin="0,0,12,0" IsOpen="False"/>
                        <ui:Button Content="清理缓存"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Click="ClearCache_Click"/>
                    </StackPanel>
                </ui:CardControl>
            </Border>

            <TextBlock Text="关于" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}">
                <ui:CardExpander Icon="{ui:SymbolIcon Info24}" Header="MOD 开发工具箱"
                                 Margin="4" Padding="16,12" IsExpanded="False">
                    <StackPanel Margin="8,0,0,4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="v2.0.0 · MIT License"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="基于 WPF + WPF-UI（Fluent 风格）构建，界面简洁美观。"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                   Text="数据来源：Modrinth API / CurseForge API"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   Text="项目仓库：https://github.com/CHA1007/Auto-Depen"/>
                    </StackPanel>
                </ui:CardExpander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
