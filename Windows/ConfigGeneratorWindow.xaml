<ui:FluentWindow x:Class="MODDevToolkit.Windows.ConfigGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="生成配置"
        Height="640" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <ui:TitleBar Title="生成配置" VerticalAlignment="Top"/>
        <Grid Margin="28,48,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock x:Name="ModTitle" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="ModDescription" FontSize="13" Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="MOD 版本"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModVersionCombo"
                             HorizontalAlignment="Stretch"
                             SelectedIndex="0" Margin="0,0,0,12">
                    <ComboBoxItem Content="最新版本"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="配置模式"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ConfigModeCombo"
                             HorizontalAlignment="Stretch"
                             SelectedIndex="0" Margin="0,0,0,12">
                    <ComboBoxItem Content="完整"/>
                    <ComboBoxItem Content="仅 Gradle"/>
                    <ComboBoxItem Content="仅配置文件"/>
                    <ComboBoxItem Content="最小"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="依赖类型"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DependencyTypeCombo"
                             HorizontalAlignment="Stretch"
                             SelectedIndex="0">
                    <ComboBoxItem Content="implementation"/>
                    <ComboBoxItem Content="compileOnly"/>
                    <ComboBoxItem Content="runtimeOnly"/>
                    <ComboBoxItem Content="api"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
            <TextBox x:Name="ConfigResult"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Consolas"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="生成配置" Appearance="Primary" Width="110"
                       Icon="{ui:SymbolIcon Code24}"
                       Click="GenerateButton_Click" Margin="0,0,10,0"/>
            <ui:Button Content="复制" Width="90"
                       Icon="{ui:SymbolIcon Copy24}"
                       Click="CopyButton_Click" Margin="0,0,10,0"/>
            <ui:Button Content="保存" Width="90"
                       Icon="{ui:SymbolIcon Save24}"
                       Click="SaveButton_Click" Margin="0,0,10,0"/>
            <ui:Button Content="关闭" Appearance="Transparent" Width="90"
                       Click="CloseButton_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
